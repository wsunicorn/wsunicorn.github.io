---
import Base from '../../../layouts/Base.astro';
import NotePage from '../../../components/NotePage.astro';
import { notesFor } from '../../../lib/notes';
export const getStaticPaths = () => notesFor('vi').map(note => ({ params: { slug: note.slug }, props: { note } }));
const { note } = Astro.props;
---
<Base lang="vi" path={`/notes/${note.slug}/`} title={note.title} description={note.description}><NotePage lang="vi" note={note} /></Base>
